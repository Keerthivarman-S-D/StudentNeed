# ===================================================================
# StudentNeed Environment Configuration Template
# Copy to .env for local development or set in Render/Firebase dashboards
# ===================================================================

# Frontend Build & API Target (Compiled into client bundle)
VITE_API_URL=https://studentneed-backend.onrender.com
VITE_COLLEGE_EMAIL_DOMAIN=student.annauniv.edu

# Backend Server Configuration
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://studentneed.me
ADMIN_EMAIL=admin@student.annauniv.edu

# Web Push VAPID Credentials (for browser notifications)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@studentneed.me

# Cloudinary Storage (for signed student image uploads)
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Resend Email Delivery Service (for student OTP emails)
RESEND_API_KEY=
EMAIL_FROM=StudentNeed <auth@studentneed.me>

# Internal System Account (for backend service REST access to Firestore)
INTERNAL_SYSTEM_EMAIL=internal.system@student.annauniv.edu
INTERNAL_SYSTEM_PASSWORD=

# Test Credentials (required for test suites, never commit real credentials)
TEST_STUDENT_EMAIL=
TEST_STUDENT_PASSWORD=
TEST_ADMIN_EMAIL=
TEST_ADMIN_PASSWORD=

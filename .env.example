# StudentNeed Hybrid Architecture
# Frontend is deployed to Firebase Hosting (Spark plan).
# Express API runs independently on Render or Google Cloud Run.
# Replace with your actual deployed backend URL when building for production.
VITE_API_URL=https://studentneed-backend.onrender.com
VITE_COLLEGE_EMAIL_DOMAIN=student.annauniv.edu

# Backend server configuration (set in Render/Cloud Run environment, NOT in frontend)
PORT=3000
NODE_ENV=production
FRONTEND_URL=https://studentneed.me
ADMIN_EMAIL=admin@student.annauniv.edu

# Resend email delivery for OTP / password reset
RESEND_API_KEY=
EMAIL_FROM=StudentNeed <auth@studentneed.me>

# Internal system account used by the standalone Express backend for Firestore REST operations
INTERNAL_SYSTEM_EMAIL=internal.system@student.annauniv.edu
INTERNAL_SYSTEM_PASSWORD=

# Cloudinary image storage
CLOUDINARY_CLOUD_NAME=
CLOUDINARY_API_KEY=
CLOUDINARY_API_SECRET=

# Browser push notifications (optional)
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:admin@student.annauniv.edu

# Optional App Check
VITE_RECAPTCHA_ENTERPRISE_KEY=
VITE_APPCHECK_DEBUG_TOKEN=

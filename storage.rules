rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    // Listing images: Any authenticated user can read; only the authenticated owner can write to listings/{userId}/...
    match /listings/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                    && request.auth.uid == userId
                    && request.resource.size <= 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }

    // Profile avatars: Any authenticated user can read; only the authenticated owner can write to avatars/{userId}/...
    match /avatars/{userId}/{fileName} {
      allow read: if request.auth != null;
      allow write: if request.auth != null 
                    && request.auth.uid == userId
                    && request.resource.size <= 5 * 1024 * 1024
                    && request.resource.contentType.matches('image/.*');
      allow delete: if request.auth != null && request.auth.uid == userId;
    }
  }
}

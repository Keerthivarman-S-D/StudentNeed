{
  "name": "react-example",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "overrides": {
    "@grpc/grpc-js": "1.14.6"
  },
  "scripts": {
    "dev": "tsx server.ts",
    "build:client": "vite build",
    "build:server": "esbuild server.ts --bundle --platform=node --format=cjs --packages=external --outfile=dist-server/server.cjs",
    "check:deploy": "tsx scripts/verify-deploy.ts",
    "build": "npm run build:client && npm run build:server && npm run check:deploy",
    "start": "node dist-server/server.cjs",
    "preview": "vite preview",
    "clean": "node -e \"const fs=require('fs'); fs.rmSync('dist',{recursive:true,force:true}); fs.rmSync('dist-server',{recursive:true,force:true});\"",
    "lint": "tsc --noEmit",
    "test": "tsx test_requests_chat.ts && tsx test_password_security.ts && tsx test_auth_redesign.ts && tsx test_marketplace_redesign.ts && tsx test_listing_detail_redesign.ts && tsx test_requests_redesign.ts && tsx test_chat_redesign.ts && tsx test_profile_redesign.ts && tsx test_integration_regression.ts && tsx test_registration_legal_flow.ts && tsx test_genui_spec.ts && tsx test_notifications_spec.ts && tsx test_request_expiry_spec.ts && tsx test_production_build_separation.ts && tsx test_production_api_connectivity.ts && tsx test_production_security_rules.ts && tsx test_production_otp_resilience.ts && tsx test_accessibility_performance.ts && tsx test_production_regression_fix.ts && tsx test_phase1_security_optimization.ts && tsx test_phase2_performance_optimization.ts",
    "test:phase1": "tsx test_phase1_security_optimization.ts",
    "test:phase2": "tsx test_phase2_performance_optimization.ts",
    "test:load": "tsx scripts/load-test.ts",
    "test:smoke": "tsx scripts/load-test.ts",
    "test:staging-load": "tsx scripts/staging-load-test.ts",
    "test:staging:local": "tsx scripts/staging-load-test.ts --confirm-staging --local-staging",
    "test:staging:smoke": "tsx scripts/staging-load-test.ts --confirm-staging --local-staging --smoke-only",
    "test:e2e:staging": "tsx scripts/authenticated-staging-validation.ts --confirm-staging --local-staging",
    "seed:staging": "tsx scripts/seed-staging-data.ts",
    "clean:staging": "tsx scripts/seed-staging-data.ts --clean",
    "test:production": "tsx test_production_build_separation.ts && tsx test_production_api_connectivity.ts && tsx test_production_security_rules.ts && tsx test_production_otp_resilience.ts && tsx test_hybrid_architecture.ts",
    "test:expiry": "tsx test_request_expiry_spec.ts",
    "test:notifications": "tsx test_notifications_spec.ts",
    "test:genui": "tsx test_genui_spec.ts",
    "test:security": "tsx test_password_security.ts",
    "test:auth": "tsx test_auth_redesign.ts",
    "test:marketplace": "tsx test_marketplace_redesign.ts",
    "test:detail": "tsx test_listing_detail_redesign.ts",
    "test:requests": "tsx test_requests_redesign.ts",
    "test:chat": "tsx test_chat_redesign.ts",
    "test:profile": "tsx test_profile_redesign.ts",
    "test:integration": "tsx test_integration_regression.ts",
    "test:accessibility": "tsx test_accessibility_performance.ts",
    "test:hybrid": "tsx test_hybrid_architecture.ts"
  },
  "dependencies": {
    "@google/genai": "^2.4.0",
    "@tailwindcss/vite": "^4.1.14",
    "@vitejs/plugin-react": "^5.0.4",
    "bcryptjs": "^3.0.3",
    "clsx": "^2.1.1",
    "cors": "^2.8.6",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "firebase": "^12.17.1",
    "helmet": "^8.3.0",
    "lucide-react": "^0.546.0",
    "motion": "^12.23.24",
    "react": "^19.0.1",
    "react-dom": "^19.0.1",
    "react-router-dom": "^7.18.2",
    "resend": "^6.22.1",
    "sharp": "^0.35.5",
    "tailwind-merge": "^3.6.0",
    "vite": "^6.2.3",
    "web-push": "^3.6.7",
    "google-auth-library": "^10.3.0"
  },
  "devDependencies": {
    "@types/bcryptjs": "^3.0.0",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/node": "^22.14.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@types/web-push": "^3.6.4",
    "autoprefixer": "^10.4.21",
    "esbuild": "^0.28.2",
    "tailwindcss": "^4.1.14",
    "tsx": "^4.23.12",
    "typescript": "~5.8.2",
    "vite": "^6.2.3"
  }
}

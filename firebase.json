{
  "firestore": [
    {
      "database": "ai-studio-studentneed-4d3006be-d546-44c7-b37a-4536f7d5aff9",
      "rules": "firestore.rules",
      "indexes": "firestore.indexes.json"
    }
  ],
  "storage": {
    "rules": "storage.rules"
  },
  "hosting": {
    "public": "dist",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "**/*.cjs",
      "**/*.map",
      "**/server.*",
      "**/dist-server/**"
    ],
    "rewrites": [
      {
        "source": "!/api/**",
        "destination": "/index.html"
      }
    ],
    "headers": [
      {
        "source": "/@(firebase-messaging-sw|sw).js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, no-store, must-revalidate"
          },
          {
            "key": "Service-Worker-Allowed",
            "value": "/"
          }
        ]
      }
    ]
  }
}

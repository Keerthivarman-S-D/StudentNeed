rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isCollegeEmail() {
      return isAuthenticated() &&
             request.auth.token.email != null &&
             request.auth.token.email.matches('.*@student\\.annauniv\\.edu');
    }

    function isInternalSystem() {
      return isAuthenticated() && (
        request.auth.token.email == 'internal.system@student.annauniv.edu' ||
        request.auth.token.email == 'admin@student.annauniv.edu'
      );
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@student.annauniv.edu' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    // A student is only verified once they have an existing user profile created via server-side OTP verification
    // with isVerified == true. Missing user documents strictly DO NOT grant access.
    function isVerifiedStudent() {
      return isCollegeEmail() &&
             exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             get(/databases/$(database)/documents/users/$(request.auth.uid)).data.isVerified == true &&
             (!('status' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
              (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'suspended' &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'banned'));
    }

    function isAnnaUnivStudent() {
      return isVerifiedStudent();
    }

    function isAuthorizedStudent() {
      return isVerifiedStudent() || isAdmin() || isInternalSystem();
    }

    function isUserActive() {
      return exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
             (!('status' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
              (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'suspended' &&
               get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'banned'));
    }

    match /users/{userId} {
      // Authenticated users can read their own profile document; verified students/admins can read public student profiles
      allow read: if isAuthorizedStudent() || (isAuthenticated() && request.auth.uid == userId);

      // Creating a user profile:
      // Restricted to verified admin/server system account after OTP verification
      allow create: if isAdmin() || isInternalSystem();

      // Updating user profile:
      // - Owner can update, but cannot alter protected fields:
      //   role, isVerified, email, id, rating, exchangesCompleted, completedTransactions,
      //   successfulExchanges, ratingCount, reviewCount, trustScore, reputation, badges, statistics, createdAt,
      //   status, warningCount, warnings, statusReason, statusUpdatedAt, suspendedAt, bannedAt, lastActivityAt
      // - Rating and exchangesCompleted must strictly match existing values if provided
      // - Admin or system service account can update any profile
      allow update: if isAuthorizedStudent() && (
        (
          request.auth.uid == userId &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'isVerified', 'email', 'id', 'rating',
            'exchangesCompleted', 'completedTransactions', 'successfulExchanges',
            'ratingCount', 'reviewCount', 'trustScore', 'reputation',
            'badges', 'statistics', 'createdAt',
            'status', 'warningCount', 'warnings', 'statusReason',
            'statusUpdatedAt', 'suspendedAt', 'bannedAt', 'lastActivityAt'
          ])) &&
          request.resource.data.get('id', resource.data.get('id', '')) == resource.data.get('id', '') &&
          request.resource.data.get('role', resource.data.get('role', 'student')) == resource.data.get('role', 'student') &&
          request.resource.data.get('status', resource.data.get('status', 'active')) == resource.data.get('status', 'active') &&
          request.resource.data.get('rating', resource.data.get('rating', 0)) == resource.data.get('rating', 0) &&
          request.resource.data.get('exchangesCompleted', resource.data.get('exchangesCompleted', 0)) == resource.data.get('exchangesCompleted', 0)
        ) ||
        isAdmin() ||
        isInternalSystem()
      );

      allow delete: if false;

      // Private user PII subcollection: phone, private email, sensitive preferences
      // Strictly isolated to the document owner or system admin
      match /private/{docId} {
        allow read, write: if isAuthorizedStudent() && (request.auth.uid == userId || isAdmin() || isInternalSystem());
      }
    }

    function isValidImageUrl(url) {
      return url is string &&
             url.size() <= 1000 &&
             (
               url.matches('^https://res\\.cloudinary\\.com/.*') ||
               url.matches('^https://images\\.unsplash\\.com/.*')
             );
    }

    function isValidCampusLocation(loc) {
      return loc is string && (
        loc == 'Main Gate' ||
        loc == 'Hostel Gate' ||
        loc == 'Back Gate' ||
        loc == 'MIT Library' ||
        loc == 'Canteen' ||
        loc == 'Hanger 1' ||
        loc == 'Hanger 2' ||
        loc == 'MIT Connect' ||
        loc == 'Central Library' ||
        loc == 'Library' ||
        loc == 'Food Court' ||
        loc == 'Hostel' ||
        loc == 'Hostel Zone' ||
        loc == 'CSE Block' ||
        loc == 'ECE Block' ||
        loc == 'SBI ATM' ||
        loc == 'Sports Ground'
      );
    }

    function validListingImages(data) {
      return !('images' in data) || data.images == null || (
        data.images is list &&
        data.images.size() <= 3 &&
        (
          data.images.size() == 0 ||
          (
            isValidImageUrl(data.images[0]) &&
            (data.images.size() < 2 || isValidImageUrl(data.images[1])) &&
            (data.images.size() < 3 || isValidImageUrl(data.images[2]))
          )
        )
      );
    }

    function isValidListingContent(data) {
      return ('title' in data) &&
             data.title is string &&
             data.title.size() >= 3 &&
             data.title.size() <= 50 &&
             ('description' in data) &&
             data.description is string &&
             data.description.size() >= 10 &&
             data.description.size() <= 100 &&
             ('location' in data) &&
             isValidCampusLocation(data.location) &&
             validListingImages(data) &&
             (
               // If type is Sale, price is required and must be between 1 and 10000
               (data.type == 'Sale' && ('price' in data) &&
                (data.price is int || data.price is float || data.price is number) &&
                data.price >= 1 && data.price <= 10000) ||
               // If type is not Sale, price is optional, but if present must be 1 to 10000
               (data.type != 'Sale' && (!('price' in data) || data.price == null ||
                ((data.price is int || data.price is float || data.price is number) &&
                 data.price >= 1 && data.price <= 10000)))
             );
    }

    function isValidExpiration(reqData) {
      return ('expiresAt' in reqData) &&
             reqData.expiresAt is timestamp &&
             reqData.expiresAt > request.time - duration.value(1, 'h') &&
             reqData.expiresAt <= request.time + duration.value(35, 'd') &&
             (!('expirationDays' in reqData) || reqData.expirationDays in [7, 15, 30]);
    }

    function isValidRequestExpiration(reqData) {
      return ('expiresAt' in reqData) &&
             reqData.expiresAt is timestamp &&
             reqData.expiresAt > request.time - duration.value(5, 'm') &&
             reqData.expiresAt <= request.time + duration.value(25, 'h');
    }

    function isValidRequestDeleteAt(reqData) {
      return !('deleteAt' in reqData) ||
             (reqData.deleteAt is timestamp &&
              reqData.deleteAt > request.time &&
              reqData.deleteAt <= request.time + duration.value(32, 'd'));
    }

    match /listings/{listingId} {
      allow read: if isAuthorizedStudent();

      // Only authenticated Anna Univ students can create listings where sellerId matches their UID
      // Must start with available/active status, satisfy content & image constraints, and provide valid expiration
      allow create: if isAnnaUnivStudent() &&
                       isUserActive() &&
                       request.resource.data.sellerId == request.auth.uid &&
                       request.resource.data.status in ['available', 'active'] &&
                       isValidListingContent(request.resource.data) &&
                       isValidExpiration(request.resource.data);

      // Updates:
      // - Cannot transition if already cancelled, completed, or removed
      // - ONLY the listing owner (seller) or admin can modify or change listing status
      // - Arbitrary non-owner status tampering (IDOR/DoS) is strictly forbidden
      // - Owner can modify listing details while preserving images constraint, valid bounds, and sellerId
      // - Expiration date and creation date are strictly immutable by seller to prevent immortal listings
      // - Owner cannot alter moderation fields (reportCount, moderationReason, moderatedAt, moderatedBy, flaggedForReview)
      allow update: if isAuthorizedStudent() && (
        (
          isUserActive() &&
          resource.data.status != 'cancelled' &&
          resource.data.status != 'completed' &&
          resource.data.status != 'removed' &&
          resource.data.sellerId == request.auth.uid &&
          request.resource.data.sellerId == resource.data.sellerId &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'reportCount', 'moderationReason', 'moderatedAt', 'moderatedBy', 'flaggedForReview'
          ])) &&
          (!('expiresAt' in resource.data) || !('expiresAt' in request.resource.data) || request.resource.data.expiresAt == resource.data.expiresAt) &&
          (!('expirationDays' in resource.data) || !('expirationDays' in request.resource.data) || request.resource.data.expirationDays == resource.data.expirationDays) &&
          (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
          (
            // Cancellation transition
            (request.resource.data.status == 'cancelled' && resource.data.status in ['available', 'active', 'reserved']) ||
            // Regular active/available/reserved edit by owner (must satisfy valid listing constraints)
            (request.resource.data.status in ['available', 'active', 'reserved'] && isValidListingContent(request.resource.data))
          )
        ) ||
        isAdmin() ||
        isInternalSystem()
      );

      // Preserve cancelled/completed records for history; only admins and server cleanup may permanently remove
      allow delete: if isAdmin() || isInternalSystem();
    }

    match /requests/{requestId} {
      allow read: if isAuthorizedStudent();

      // Only authenticated Anna Univ students can create requests with requesterId matching their UID,
      // with a 24-hour expiration and 30-day retention window
      allow create: if isAnnaUnivStudent() &&
                       isUserActive() &&
                       request.resource.data.requesterId == request.auth.uid &&
                       request.resource.data.status in ['open', 'active'] &&
                       isValidRequestExpiration(request.resource.data) &&
                       isValidRequestDeleteAt(request.resource.data) &&
                       (!('renewalCount' in request.resource.data) || request.resource.data.renewalCount == 0);

      // Updates:
      // - Cannot transition if already cancelled or completed
      // - Only owner, admin, or internal system can update request
      // - Arbitrary non-owner tampering is strictly forbidden
      // - Creation date and requesterId are strictly immutable
      // - Renewal allows owner to extend expiration by 24h, advancing renewalCount and renewedAt
      // - Non-renewal edits preserve expiration and deletion deadlines
      allow update: if isAuthorizedStudent() && (
        (
          isUserActive() &&
          resource.data.status != 'cancelled' &&
          resource.data.status != 'completed' &&
          resource.data.requesterId == request.auth.uid &&
          request.resource.data.requesterId == resource.data.requesterId &&
          (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
          (
            // Case A: Owner renewal transition (extends expiration by 24h)
            (
              request.resource.data.expiresAt != resource.data.expiresAt &&
              resource.data.status in ['open', 'active', 'expired'] &&
              request.resource.data.status in ['open', 'active'] &&
              isValidRequestExpiration(request.resource.data) &&
              isValidRequestDeleteAt(request.resource.data) &&
              request.resource.data.renewalCount == (('renewalCount' in resource.data) ? resource.data.renewalCount + 1 : 1)
            ) ||
            // Case B: Regular owner edit or cancellation (expiration and retention remain immutable)
            (
              (!('expiresAt' in resource.data) || !('expiresAt' in request.resource.data) || request.resource.data.expiresAt == resource.data.expiresAt) &&
              (!('deleteAt' in resource.data) || !('deleteAt' in request.resource.data) || request.resource.data.deleteAt == resource.data.deleteAt) &&
              (!('renewalCount' in resource.data) || !('renewalCount' in request.resource.data) || request.resource.data.renewalCount == resource.data.renewalCount) &&
              request.resource.data.status in ['open', 'active', 'matched', 'accepted', 'completed', 'cancelled', 'expired']
            )
          )
        ) ||
        isAdmin() ||
        isInternalSystem()
      );

      // Preserve request records for history/retention; only admins and server cleanup may permanently remove
      allow delete: if isAdmin() || isInternalSystem();
    }



    function isMeetupParticipant(resData) {
      return request.auth.uid == resData.buyerId || request.auth.uid == resData.sellerId;
    }

    function isProposingMeetup(resData, reqData) {
      return reqData.meetup.status == 'proposed' &&
             isValidCampusLocation(reqData.meetup.location) &&
             reqData.meetup.proposedBy == request.auth.uid &&
             (
               !('meetup' in resData) ||
               resData.meetup == null ||
               !('status' in resData.meetup) ||
               resData.meetup.status == 'not_set' ||
               resData.meetup.status == 'cancelled' ||
               resData.meetup.status == 'proposed'
             );
    }

    function isConfirmingMeetup(resData, reqData) {
      return reqData.meetup.status == 'confirmed' &&
             ('meetup' in resData) &&
             resData.meetup != null &&
             ('status' in resData.meetup) &&
             resData.meetup.status == 'proposed' &&
             request.auth.uid != resData.meetup.proposedBy &&
             reqData.meetup.location == resData.meetup.location;
    }

    function isCancellingMeetup(resData, reqData) {
      return reqData.meetup.status == 'cancelled' &&
             ('meetup' in resData) &&
             resData.meetup != null &&
             ('status' in resData.meetup) &&
             (resData.meetup.status == 'proposed' || resData.meetup.status == 'confirmed');
    }

    function isValidMeetupTransition(resData, reqData) {
      return ('meetup' in reqData) &&
             (reqData.meetup is map) &&
             (
               isProposingMeetup(resData, reqData) ||
               isConfirmingMeetup(resData, reqData) ||
               isCancellingMeetup(resData, reqData)
             );
    }

    match /reservations/{reservationId} {
      allow read: if isAuthorizedStudent() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin() ||
        isInternalSystem()
      );

      // Only authenticated Anna Univ students can create a reservation in 'pending' status for another student's active listing
      allow create: if isAnnaUnivStudent() &&
                       isUserActive() &&
                       request.resource.data.buyerId == request.auth.uid &&
                       request.resource.data.sellerId != request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.listingId is string &&
                       request.resource.data.chatId is string &&
                       exists(/databases/$(database)/documents/listings/$(request.resource.data.listingId)) &&
                       get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.status in ['available', 'active'] &&
                       request.resource.data.sellerId == get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.sellerId;

      // Updates:
      // 1. Status transitions: ONLY seller can transition from 'pending' to 'accepted' or 'rejected'
      // 2. Buyer re-request: ONLY original buyer can transition from 'rejected' to 'pending' (core IDs strictly immutable and listing still active)
      // 3. Buyer cancel pending: ONLY original buyer can transition from 'pending' to 'cancelled'
      // 4. Buyer/Seller cancel accepted: ONLY buyer or seller can transition from 'accepted' to 'cancelled'
      // 5. Campus meetup updates: ONLY on ACCEPTED reservations by buyer or seller
      // 6. Completion transition: ONLY from 'accepted' to 'completed' by legitimate participants (buyer or seller)
      //    All core IDs remain strictly immutable and listing belongs to seller
      // 7. Terminal state: Completed or cancelled reservations cannot be mutated
      allow update: if isAuthorizedStudent() && (
        (
          // Seller accept or reject pending reservation
          resource.data.sellerId == request.auth.uid &&
          request.resource.data.sellerId == resource.data.sellerId &&
          request.resource.data.buyerId == resource.data.buyerId &&
          request.resource.data.listingId == resource.data.listingId &&
          request.resource.data.chatId == resource.data.chatId &&
          resource.data.status == 'pending' &&
          (request.resource.data.status == 'accepted' || request.resource.data.status == 'rejected') &&
          (
            request.resource.data.status == 'rejected' ||
            (
              request.resource.data.status == 'accepted' &&
              exists(/databases/$(database)/documents/listings/$(resource.data.listingId)) &&
              get(/databases/$(database)/documents/listings/$(resource.data.listingId)).data.status in ['available', 'active']
            )
          )
        ) ||
        (
          // Buyer re-request rejected reservation
          resource.data.buyerId == request.auth.uid &&
          request.resource.data.buyerId == resource.data.buyerId &&
          request.resource.data.sellerId == resource.data.sellerId &&
          request.resource.data.listingId == resource.data.listingId &&
          request.resource.data.chatId == resource.data.chatId &&
          (resource.data.status == 'rejected' || resource.data.status == 'cancelled') &&
          request.resource.data.status == 'pending' &&
          exists(/databases/$(database)/documents/listings/$(resource.data.listingId)) &&
          get(/databases/$(database)/documents/listings/$(resource.data.listingId)).data.status in ['available', 'active']
        ) ||
        (
          // Buyer can cancel pending reservation
          resource.data.buyerId == request.auth.uid &&
          request.resource.data.buyerId == resource.data.buyerId &&
          request.resource.data.sellerId == resource.data.sellerId &&
          request.resource.data.listingId == resource.data.listingId &&
          request.resource.data.chatId == resource.data.chatId &&
          resource.data.status == 'pending' &&
          request.resource.data.status == 'cancelled'
        ) ||
        (
          // Buyer or Seller can cancel accepted reservation
          (resource.data.buyerId == request.auth.uid || resource.data.sellerId == request.auth.uid) &&
          request.resource.data.buyerId == resource.data.buyerId &&
          request.resource.data.sellerId == resource.data.sellerId &&
          request.resource.data.listingId == resource.data.listingId &&
          request.resource.data.chatId == resource.data.chatId &&
          resource.data.status == 'accepted' &&
          request.resource.data.status == 'cancelled'
        ) ||
        (
          // Meetup transitions on accepted reservations
          resource.data.status == 'accepted' &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.sellerId == resource.data.sellerId &&
          request.resource.data.buyerId == resource.data.buyerId &&
          request.resource.data.listingId == resource.data.listingId &&
          request.resource.data.chatId == resource.data.chatId &&
          isMeetupParticipant(resource.data) &&
          isValidMeetupTransition(resource.data, request.resource.data)
        ) ||
        (
          // Legitimate completion: accepted -> completed only
          resource.data.status == 'accepted' &&
          request.resource.data.status == 'completed' &&
          request.resource.data.sellerId == resource.data.sellerId &&
          request.resource.data.buyerId == resource.data.buyerId &&
          request.resource.data.listingId == resource.data.listingId &&
          request.resource.data.chatId == resource.data.chatId &&
          isMeetupParticipant(resource.data) &&
          exists(/databases/$(database)/documents/listings/$(resource.data.listingId)) &&
          get(/databases/$(database)/documents/listings/$(resource.data.listingId)).data.sellerId == resource.data.sellerId
        ) ||
        isAdmin() ||
        isInternalSystem()
      );

      allow delete: if false;
    }

    match /chats/{chatId} {
      allow get: if isAuthorizedStudent() && (
        resource == null ||
        request.auth.uid in resource.data.participants ||
        isAdmin() ||
        isInternalSystem()
      );
      allow list: if isAuthorizedStudent() && (
        request.auth.uid in resource.data.participants ||
        isAdmin() ||
        isInternalSystem()
      );
      allow update: if isAuthorizedStudent() &&
                       request.auth.uid in resource.data.participants &&
                       request.resource.data.participants == resource.data.participants;
      allow create: if isAnnaUnivStudent() &&
                       request.auth.uid in request.resource.data.participants &&
                       request.resource.data.participants is list &&
                       request.resource.data.participants.size() == 2 &&
                       request.resource.data.participants[0] != request.resource.data.participants[1] &&
                       (!('listingId' in request.resource.data) || request.resource.data.listingId is string) &&
                       (!('requestId' in request.resource.data) || request.resource.data.requestId is string) &&
                       (
                         !('requestId' in request.resource.data) ||
                         (
                           !exists(/databases/$(database)/documents/requests/$(request.resource.data.requestId)) ||
                           (
                             (!('expiresAt' in get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data) ||
                              get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.expiresAt > request.time) &&
                             get(/databases/$(database)/documents/requests/$(request.resource.data.requestId)).data.status in ['open', 'active']
                           )
                         )
                       );
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthorizedStudent() &&
                       (request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants || isAdmin() || isInternalSystem());
        allow create: if isAnnaUnivStudent() &&
                         isUserActive() &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                         request.resource.data.senderId == request.auth.uid &&
                         request.resource.data.text is string &&
                         request.resource.data.text.size() > 0 &&
                         request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    match /locations/{locationId} {
      allow read: if isAuthorizedStudent();
      allow write: if isAdmin() || isInternalSystem();
    }

    // Reports Collection for User Moderation
    match /reports/{reportId} {
      // Normal users can read their own submitted reports; Admin can read all reports
      allow read: if isAuthorizedStudent() && (
        resource.data.reporterId == request.auth.uid ||
        isAdmin() ||
        isInternalSystem()
      );

      // Active users can submit a pending report
      allow create: if isAnnaUnivStudent() &&
                       isUserActive() &&
                       request.resource.data.reporterId == request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.reason is string &&
                       request.resource.data.listingId is string &&
                       request.resource.data.reportedUserId is string;

      // Only admin can update (resolve, dismiss, review) or delete reports
      allow update, delete: if isAdmin() || isInternalSystem();
    }

    // Admin Audit Logs: strictly readable and writable by admin only
    match /admin_audit_logs/{logId} {
      allow read, write: if isAdmin() || isInternalSystem();
    }

    // Activity Logs for Moderation and Monitoring
    match /activity_logs/{logId} {
      // Normal users can only read their own activity; Admin can read all activity
      allow read: if isAdmin() || isInternalSystem() || (
        isAuthorizedStudent() && resource.data.userId == request.auth.uid
      );

      // Admin can log activity, or authenticated users can log their own activity with strict field whitelist
      allow create: if isAdmin() || isInternalSystem() || (
        isAnnaUnivStudent() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll(['userId', 'action']) &&
        (request.resource.data.keys().hasAny(['createdAt', 'timestamp'])) &&
        request.resource.data.keys().hasOnly([
          'userId', 'action', 'details', 'createdAt', 'timestamp',
          'targetId', 'targetType', 'id', 'userEmail'
        ])
      );

      // Activity logs are append-only; users cannot update or delete existing logs
      allow update, delete: if false;
    }

    // Temporary server-side OTP store for registration verification
    // Strictly restricted to the server's internal service account or admin
    match /temp_otps/{otpId} {
      allow read, write: if isInternalSystem() || isAdmin();
    }

    // Real-Time Event-Driven Notifications System
    match /notifications/{notificationId} {
      // Users can only read their own notifications
      allow read: if isAuthorizedStudent() && (
        resource.data.recipientUid == request.auth.uid ||
        isAdmin() ||
        isInternalSystem()
      );

      // Notifications can be created by the internal system, admin, or an authenticated user triggering an event for another user
      allow create: if isAuthorizedStudent() && (
        isInternalSystem() ||
        isAdmin() ||
        (
          isUserActive() &&
          request.resource.data.recipientUid != request.auth.uid &&
          request.resource.data.actorUid == request.auth.uid &&
          request.resource.data.read == false &&
          request.resource.data.title is string &&
          request.resource.data.body is string &&
          request.resource.data.type in ['chat', 'reservation', 'request', 'listing', 'system']
        )
      );

      // Recipients can only update their own read status (read, readAt)
      allow update: if isAuthorizedStudent() && (
        (
          resource.data.recipientUid == request.auth.uid &&
          request.resource.data.recipientUid == resource.data.recipientUid &&
          request.resource.data.diff(resource.data).affectedKeys().hasOnly(['read', 'readAt', 'updatedAt'])
        ) ||
        isAdmin() ||
        isInternalSystem()
      );

      // Recipients or admins can delete their own notifications
      allow delete: if isAuthorizedStudent() && (
        resource.data.recipientUid == request.auth.uid ||
        isAdmin() ||
        isInternalSystem()
      );
    }
  }
}

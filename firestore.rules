rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAnnaUnivStudent() {
      return isAuthenticated() &&
             request.auth.token.email != null &&
             request.auth.token.email.matches('.*@student\\.annauniv\\.edu');
    }

    function isAdmin() {
      return isAuthenticated() && (
        request.auth.token.email == 'admin@student.annauniv.edu' ||
        (exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin')
      );
    }

    function isUserActive() {
      return !exists(/databases/$(database)/documents/users/$(request.auth.uid)) ||
             !('status' in get(/databases/$(database)/documents/users/$(request.auth.uid)).data) ||
             (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'suspended' &&
              get(/databases/$(database)/documents/users/$(request.auth.uid)).data.status != 'banned');
    }

    match /users/{userId} {
      allow read: if isAuthenticated();

      // Creating a user profile:
      // Restricted to verified admin/server system account after OTP verification
      allow create: if isAdmin();

      // Updating user profile:
      // - Owner can update, but cannot alter protected fields:
      //   role, isVerified, email, id, rating, exchangesCompleted, completedTransactions,
      //   successfulExchanges, ratingCount, reviewCount, trustScore, reputation, badges, statistics, createdAt,
      //   status, warningCount, warnings, statusReason, statusUpdatedAt, suspendedAt, bannedAt, lastActivityAt
      // - Rating and exchangesCompleted must strictly match existing values if provided
      // - Admin can update any profile
      allow update: if isAuthenticated() && (
        (
          request.auth.uid == userId &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'role', 'isVerified', 'email', 'id', 'rating',
            'exchangesCompleted', 'completedTransactions', 'successfulExchanges',
            'ratingCount', 'reviewCount', 'trustScore', 'reputation',
            'badges', 'statistics', 'createdAt',
            'status', 'warningCount', 'warnings', 'statusReason',
            'statusUpdatedAt', 'suspendedAt', 'bannedAt', 'lastActivityAt'
          ])) &&
          request.resource.data.get('id', resource.data.get('id', '')) == resource.data.get('id', '') &&
          request.resource.data.get('role', resource.data.get('role', 'student')) == resource.data.get('role', 'student') &&
          request.resource.data.get('status', resource.data.get('status', 'active')) == resource.data.get('status', 'active') &&
          request.resource.data.get('rating', resource.data.get('rating', 0)) == resource.data.get('rating', 0) &&
          request.resource.data.get('exchangesCompleted', resource.data.get('exchangesCompleted', 0)) == resource.data.get('exchangesCompleted', 0)
        ) ||
        isAdmin()
      );

      allow delete: if false;

      // Private user PII subcollection: phone, private email, sensitive preferences
      // Strictly isolated to the document owner or system admin
      match /private/{docId} {
        allow read, write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    function isValidImageUrl(url) {
      return url is string &&
             url.size() <= 1000 &&
             (
               url.matches('^https://res\\.cloudinary\\.com/.*') ||
               url.matches('^https://images\\.unsplash\\.com/.*')
             );
    }

    function validListingImages(data) {
      return !('images' in data) || data.images == null || (
        data.images is list &&
        data.images.size() <= 5 &&
        (
          data.images.size() == 0 ||
          (
            isValidImageUrl(data.images[0]) &&
            (data.images.size() < 2 || isValidImageUrl(data.images[1])) &&
            (data.images.size() < 3 || isValidImageUrl(data.images[2])) &&
            (data.images.size() < 4 || isValidImageUrl(data.images[3])) &&
            (data.images.size() < 5 || isValidImageUrl(data.images[4]))
          )
        )
      );
    }

    function isValidExpiration(reqData) {
      return ('expiresAt' in reqData) &&
             reqData.expiresAt is timestamp &&
             reqData.expiresAt > request.time - duration.value(1, 'h') &&
             reqData.expiresAt <= request.time + duration.value(35, 'd') &&
             (!('expirationDays' in reqData) || reqData.expirationDays in [7, 15, 30]);
    }

    match /listings/{listingId} {
      allow read: if isAuthenticated();

      // Only authenticated users can create listings where sellerId matches their UID
      // Must start with available/active status, satisfy image constraints, and provide valid expiration
      allow create: if isAuthenticated() &&
                       isUserActive() &&
                       request.resource.data.sellerId == request.auth.uid &&
                       request.resource.data.status in ['available', 'active'] &&
                       validListingImages(request.resource.data) &&
                       isValidExpiration(request.resource.data);

      // Updates:
      // - Cannot transition if already cancelled, completed, or removed
      // - ONLY the listing owner (seller) or admin can modify or change listing status
      // - Arbitrary non-owner status tampering (IDOR/DoS) is strictly forbidden
      // - Owner can modify listing details while preserving images constraint and sellerId
      // - Expiration date and creation date are strictly immutable by seller to prevent immortal listings
      // - Owner cannot alter moderation fields (reportCount, moderationReason, moderatedAt, moderatedBy, flaggedForReview)
      allow update: if isAuthenticated() && (
        (
          isUserActive() &&
          resource.data.status != 'cancelled' &&
          resource.data.status != 'completed' &&
          resource.data.status != 'removed' &&
          resource.data.sellerId == request.auth.uid &&
          request.resource.data.sellerId == resource.data.sellerId &&
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny([
            'reportCount', 'moderationReason', 'moderatedAt', 'moderatedBy', 'flaggedForReview'
          ])) &&
          (!('expiresAt' in resource.data) || !('expiresAt' in request.resource.data) || request.resource.data.expiresAt == resource.data.expiresAt) &&
          (!('expirationDays' in resource.data) || !('expirationDays' in request.resource.data) || request.resource.data.expirationDays == resource.data.expirationDays) &&
          (!('createdAt' in resource.data) || !('createdAt' in request.resource.data) || request.resource.data.createdAt == resource.data.createdAt) &&
          (
            // Cancellation transition
            (request.resource.data.status == 'cancelled' && resource.data.status in ['available', 'active', 'reserved']) ||
            // Regular active/available/reserved edit by owner (completed can only be set via legitimate reservation completion workflow / admin)
            (request.resource.data.status in ['available', 'active', 'reserved'] && validListingImages(request.resource.data))
          )
        ) ||
        isAdmin()
      );

      // Preserve cancelled/completed records for history; only admins and server cleanup may permanently remove
      allow delete: if isAdmin();
    }

    match /requests/{requestId} {
      allow read: if isAuthenticated();

      // Only authenticated users can create requests with requesterId matching their UID
      allow create: if isAuthenticated() &&
                       isUserActive() &&
                       request.resource.data.requesterId == request.auth.uid &&
                       request.resource.data.status in ['open', 'active'];

      // Updates:
      // - Cannot transition if already cancelled or completed
      // - Only owner can update or cancel request
      allow update: if isAuthenticated() && (
        (
          resource.data.status != 'cancelled' &&
          resource.data.status != 'completed' &&
          resource.data.requesterId == request.auth.uid &&
          request.resource.data.requesterId == resource.data.requesterId &&
          request.resource.data.status in ['open', 'active', 'matched', 'accepted', 'completed', 'cancelled']
        ) ||
        isAdmin()
      );

      // Preserve request records for history; only admins may permanently remove
      allow delete: if isAdmin();
    }

    function isValidCampusLocation(loc) {
      return loc == 'Main Gate' ||
             loc == 'Central Library' ||
             loc == 'Food Court' ||
             loc == 'Hostel' ||
             loc == 'CSE Block' ||
             loc == 'ECE Block';
    }

    function isMeetupParticipant(resData) {
      return request.auth.uid == resData.buyerId || request.auth.uid == resData.sellerId;
    }

    function isProposingMeetup(resData, reqData) {
      return reqData.meetup.status == 'proposed' &&
             isValidCampusLocation(reqData.meetup.location) &&
             reqData.meetup.proposedBy == request.auth.uid &&
             (
               !('meetup' in resData) ||
               resData.meetup == null ||
               !('status' in resData.meetup) ||
               resData.meetup.status == 'not_set' ||
               resData.meetup.status == 'cancelled' ||
               resData.meetup.status == 'proposed'
             );
    }

    function isConfirmingMeetup(resData, reqData) {
      return reqData.meetup.status == 'confirmed' &&
             ('meetup' in resData) &&
             resData.meetup != null &&
             ('status' in resData.meetup) &&
             resData.meetup.status == 'proposed' &&
             request.auth.uid != resData.meetup.proposedBy &&
             reqData.meetup.location == resData.meetup.location;
    }

    function isCancellingMeetup(resData, reqData) {
      return reqData.meetup.status == 'cancelled' &&
             ('meetup' in resData) &&
             resData.meetup != null &&
             ('status' in resData.meetup) &&
             (resData.meetup.status == 'proposed' || resData.meetup.status == 'confirmed');
    }

    function isValidMeetupTransition(resData, reqData) {
      return ('meetup' in reqData) &&
             (reqData.meetup is map) &&
             (
               isProposingMeetup(resData, reqData) ||
               isConfirmingMeetup(resData, reqData) ||
               isCancellingMeetup(resData, reqData)
             );
    }

    match /reservations/{reservationId} {
      allow read: if isAuthenticated() && (
        resource.data.buyerId == request.auth.uid ||
        resource.data.sellerId == request.auth.uid ||
        isAdmin()
      );

      // Only authenticated students can create a reservation in 'pending' status for another student's active listing
      allow create: if isAuthenticated() &&
                       isUserActive() &&
                       request.resource.data.buyerId == request.auth.uid &&
                       request.resource.data.sellerId != request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.listingId is string &&
                       request.resource.data.chatId is string &&
                       exists(/databases/$(database)/documents/listings/$(request.resource.data.listingId)) &&
                       get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.status in ['available', 'active'] &&
                       request.resource.data.sellerId == get(/databases/$(database)/documents/listings/$(request.resource.data.listingId)).data.sellerId;

      // Updates:
      // 1. Status transitions: ONLY seller can transition from 'pending' to 'accepted' or 'rejected'
      // 2. Buyer re-request: ONLY original buyer can transition from 'rejected' to 'pending' (core IDs strictly immutable and listing still active)
      // 3. Campus meetup updates: ONLY on ACCEPTED reservations by buyer or seller
      // 4. Completion transition: ONLY from 'accepted' to 'completed' by legitimate participants (buyer or seller)
      //    All core IDs remain strictly immutable and listing belongs to seller
      // 5. Terminal state: Completed or cancelled reservations cannot be mutated
      allow update: if isAuthenticated() && (
        (
          resource.data.sellerId == request.auth.uid &&
          request.resource.data.sellerId == resource.data.sellerId &&
          request.resource.data.buyerId == resource.data.buyerId &&
          request.resource.data.listingId == resource.data.listingId &&
          request.resource.data.chatId == resource.data.chatId &&
          resource.data.status == 'pending' &&
          (request.resource.data.status == 'accepted' || request.resource.data.status == 'rejected')
        ) ||
        (
          resource.data.buyerId == request.auth.uid &&
          request.resource.data.buyerId == resource.data.buyerId &&
          request.resource.data.sellerId == resource.data.sellerId &&
          request.resource.data.listingId == resource.data.listingId &&
          request.resource.data.chatId == resource.data.chatId &&
          resource.data.status == 'rejected' &&
          request.resource.data.status == 'pending' &&
          exists(/databases/$(database)/documents/listings/$(resource.data.listingId)) &&
          get(/databases/$(database)/documents/listings/$(resource.data.listingId)).data.status in ['available', 'active']
        ) ||
        (
          resource.data.status == 'accepted' &&
          request.resource.data.status == 'accepted' &&
          request.resource.data.sellerId == resource.data.sellerId &&
          request.resource.data.buyerId == resource.data.buyerId &&
          request.resource.data.listingId == resource.data.listingId &&
          request.resource.data.chatId == resource.data.chatId &&
          isMeetupParticipant(resource.data) &&
          isValidMeetupTransition(resource.data, request.resource.data)
        ) ||
        (
          // Legitimate completion: accepted -> completed only
          resource.data.status == 'accepted' &&
          request.resource.data.status == 'completed' &&
          request.resource.data.sellerId == resource.data.sellerId &&
          request.resource.data.buyerId == resource.data.buyerId &&
          request.resource.data.listingId == resource.data.listingId &&
          request.resource.data.chatId == resource.data.chatId &&
          isMeetupParticipant(resource.data) &&
          exists(/databases/$(database)/documents/listings/$(resource.data.listingId)) &&
          get(/databases/$(database)/documents/listings/$(resource.data.listingId)).data.sellerId == resource.data.sellerId
        ) ||
        isAdmin()
      );

      allow delete: if false;
    }

    match /chats/{chatId} {
      allow read: if isAuthenticated() && request.auth.uid in resource.data.participants;
      allow update: if isAuthenticated() &&
                       request.auth.uid in resource.data.participants &&
                       request.resource.data.participants == resource.data.participants;
      allow create: if isAuthenticated() &&
                       request.auth.uid in request.resource.data.participants &&
                       request.resource.data.participants is list &&
                       request.resource.data.participants.size() == 2 &&
                       request.resource.data.participants[0] != request.resource.data.participants[1] &&
                       (!('listingId' in request.resource.data) || request.resource.data.listingId is string) &&
                       (!('requestId' in request.resource.data) || request.resource.data.requestId is string);
      allow delete: if false;

      match /messages/{messageId} {
        allow read: if isAuthenticated() &&
                       request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants;
        allow create: if isAuthenticated() &&
                         isUserActive() &&
                         request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.participants &&
                         request.resource.data.senderId == request.auth.uid &&
                         request.resource.data.text is string &&
                         request.resource.data.text.size() > 0 &&
                         request.resource.data.text.size() <= 2000;
        allow update, delete: if false;
      }
    }

    match /locations/{locationId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Reports Collection for User Moderation
    match /reports/{reportId} {
      // Normal users can read their own submitted reports; Admin can read all reports
      allow read: if isAuthenticated() && (
        resource.data.reporterId == request.auth.uid ||
        isAdmin()
      );

      // Active users can submit a pending report
      allow create: if isAuthenticated() &&
                       isUserActive() &&
                       request.resource.data.reporterId == request.auth.uid &&
                       request.resource.data.status == 'pending' &&
                       request.resource.data.reason is string &&
                       request.resource.data.listingId is string &&
                       request.resource.data.reportedUserId is string;

      // Only admin can update (resolve, dismiss, review) or delete reports
      allow update, delete: if isAdmin();
    }

    // Admin Audit Logs: strictly readable and writable by admin only
    match /admin_audit_logs/{logId} {
      allow read, write: if isAdmin();
    }

    // Activity Logs for Moderation and Monitoring
    match /activity_logs/{logId} {
      // Normal users can only read their own activity; Admin can read all activity
      allow read: if isAdmin() || (
        isAuthenticated() && resource.data.userId == request.auth.uid
      );

      // Admin can log activity, or authenticated users can log their own activity with strict field whitelist
      allow create: if isAdmin() || (
        isAuthenticated() &&
        request.resource.data.userId == request.auth.uid &&
        request.resource.data.keys().hasAll(['userId', 'action']) &&
        (request.resource.data.keys().hasAny(['createdAt', 'timestamp'])) &&
        request.resource.data.keys().hasOnly([
          'userId', 'action', 'details', 'createdAt', 'timestamp',
          'targetId', 'targetType', 'id', 'userEmail'
        ])
      );

      // Activity logs are append-only; users cannot update or delete existing logs
      allow update, delete: if false;
    }

    // Temporary server-side OTP store for registration verification
    // Strictly restricted to the server's internal service account
    match /temp_otps/{otpId} {
      allow read, write: if isAuthenticated() &&
                            request.auth.token.email == 'admin@student.annauniv.edu';
    }
  }
}
